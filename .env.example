# Generate a private .env: npm run docker:configure -- game.your-domain.example
GAME_HOST=game.your-domain.example
SHOOTER_TICKET_SECRET=
SHOOTER_ORIGINS=https://game.your-domain.example
POSTGRES_PASSWORD=
# Set on the EXISTING Ticketsystem backend too:
SHOOTER_ENABLED=false
SHOOTER_PUBLIC_URL=https://your-game.example
# Same SHOOTER_TICKET_SECRET on both services. Never VITE_ or browser storage.
