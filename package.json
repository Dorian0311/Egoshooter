{
  "name": "altstadt-1940",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build && node scripts/compress-client.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:network": "tsx tests/network.ts",
    "preview:solo": "tsx tests/preview.ts --open",
    "host:multiplayer": "npm run build && tsx scripts/host-multiplayer.ts",
    "docker:configure": "node scripts/configure-docker.mjs",
    "test:docker": "tsx tests/docker-smoke.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.18.28",
    "@colyseus/ws-transport": "0.18.5",
    "@colyseus/sdk": "0.18.10",
    "express": "^4.21.2",
    "jose": "^6.1.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.170.0",
    "ws": "8.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.170.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "@types/ws": "^8.18.0"
  }
}
